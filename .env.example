# Station Board Backend Environment Variables
# Copy this to .env and fill in your actual values
# DO NOT commit .env to git - use Vercel environment variables instead

# Encryption & Security
ENCRYPTION_KEY=your-encryption-key-or-leave-empty
REFRESH_TOKEN=your-super-secret-refresh-token-change-this
SETUP_TOKEN=your-setup-token-change-after-first-setup

# Gmail OAuth
GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URL=http://localhost:3000/api/auth/gmail/callback

# All credentials (encrypted, generated during setup)
# Run setup endpoint to generate this
CREDENTIALS_JSON=base64-encoded-json-here
